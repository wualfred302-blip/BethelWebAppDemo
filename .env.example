# ── Required for email sending ──────────────────────────────
# Get a free API key at https://resend.com
# For local dev: set this + BETHEL_AUTH_SECRET to get real emails
# Without it, codes are logged in the server console (dev only)
RESEND_API_KEY=

# ── Required for auth security ──────────────────────────────
# Any strong random string 32+ characters.
# Used to sign OTP challenge cookies and auth session tokens.
# Generate one: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
BETHEL_AUTH_SECRET=

# ── Optional sender override ────────────────────────────────
# Defaults to "Bethel General <onboarding@resend.dev>"
# Emails from onboarding@resend.dev only reach the account owner.
# Use a verified domain for production: "Bethel General <noreply@yourdomain.com>"
RESEND_FROM_EMAIL="Bethel General <onboarding@resend.dev>"
